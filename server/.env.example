# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/purflo?retryWrites=true&w=majority

# Server
PORT=5000
NODE_ENV=production

# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_ORIGIN=https://www.purflowater.com,https://purflowater.vercel.app

# Email (Nodemailer) - using Gmail as example, use an App Password not your real password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-sending-address@gmail.com
EMAIL_PASS=your-app-password
EMAIL_TO=orders@purflowater.com
